# /usr/local/etc/partiduo-admin/admin.env — environnement de l'administration
# Partiduo, lu par le script rc.d partiduo_admin et par la planification
# (/usr/local/etc/cron.d/partiduo-admin). root:partiduo-admin, mode 0640.
# Syntaxe sh (VARIABLE=valeur, valeurs avec espaces entre apostrophes).

# Réglages de production de Marten (config/settings/production.cr).
MARTEN_ENV=production
# Clé secrète (sessions, jetons CSRF) : longue et aléatoire, par exemple
#   openssl rand -hex 32
# Le serveur refuse de démarrer tant qu'elle est vide.
MARTEN_SECRET_KEY=

# Base de l'administration (rôle partiduo-admin, socket Unix, authentification
# peer) : su -m postgres -c 'createuser partiduo-admin &&
#   createdb --owner=partiduo-admin --encoding=UTF8 partiduo_admin'
DATABASE_URL=postgres:///partiduo_admin?host=/tmp

# Port d'écoute, sur 127.0.0.1 seulement : le serveur mandataire de
# admin.<domaine> (nginx) termine TLS et pose X-Forwarded-Proto.
PORT=8200

# Domaine du parc ; hôte et adresse publique de l'administration (défauts :
# admin.<domaine> et https://admin.<domaine>).
PARTIDUO_DOMAIN=partiduo.app
#PARTIDUO_ADMIN_HOST=admin.partiduo.app
#PARTIDUO_ADMIN_URL=https://admin.partiduo.app

# Courriels : expéditeur (défaut : no-reply@<domaine>) et destinataires des
# alertes (séparés par des virgules).
PARTIDUO_ADMIN_MAIL_FROM=no-reply@partiduo.app
PARTIDUO_ADMIN_ALERTS_TO=

# Facultatif : partie de confiance WebAuthn (défaut : l'hôte), origines
# admises (séparées par des virgules), coût bcrypt (défaut : 12).
#PARTIDUO_ADMIN_RP_ID=admin.partiduo.app
#PARTIDUO_ADMIN_WEBAUTHN_ORIGINS=https://admin.partiduo.app
#PARTIDUO_BCRYPT_COST=12

# Facultatif : fichiers statiques, gabarits et traductions ailleurs que ceux
# du paquet (/usr/local/lib/partiduo-admin/share/partiduo-admin/).
#PARTIDUO_ADMIN_ASSETS_ROOT=
#PARTIDUO_ADMIN_ARTIFACTS_ROOT=
